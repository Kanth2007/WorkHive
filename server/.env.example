# ===============================================================
# SAHAKARI SEVA — ENVIRONMENT CONFIGURATION (OPTIONAL)
# ===============================================================
# If not provided, the server automatically defaults to:
# - PORT=5000
# - MONGODB_URI=mongodb://127.0.0.1:27017/sahakari_seva
# - Built-in embedded MongoDB engine if local daemon is offline
# ===============================================================

# Server Port
PORT=5000

# MongoDB Connection String (Local daemon or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/sahakari_seva

# Node Environment
NODE_ENV=development

# JWT Secret for Session Verification
JWT_SECRET=sahakari_cooperative_secret_key_2026
